// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"vim_mode": false,
	"telemetry": {
		"diagnostics": false,
		"metrics": false,
	},
	"ui_font_family": "Adwaita Sans",
	"buffer_font_family": "JetBrainsMono Nerd Font",
	"buffer_font_size": 14,
	"theme": {
		"mode": "system",
		"light": "Xcode Default Light",
		"dark": "Xcode Default Darker",
	},
	"experimental.theme_overrides": {
		"syntax": {
			"comment": {
				"font_style": "italic",
			},
			"operator": {
				"color": "#63b7fffb",
			},
		},
	},
	"colorize_brackets": true,
	"hard_tabs": true,
	"tab_size": 4,
	"soft_wrap": "editor_width",
	"cli_default_open_behavior": "new_window",
	"session": {
		"trust_all_worktrees": true,
	},
	"project_panel": {
		"hide_root": true,
	},
	"git_panel": {
		"tree_view": true,
	},
	"collaboration_panel": {
		"button": false,
	},
	"edit_predictions": {
		"provider": "copilot",
	},
	"agent": {
		"profiles": {
			"ask": {
				"name": "Ask",
				"tools": {
					"thinking": true,
					"read_file": true,
					"open": true,
					"now": true,
					"list_directory": true,
					"grep": true,
					"find_path": true,
					"fetch": true,
					"diagnostics": true,
				},
				"context_servers": {
					"mcp-server-context7": {
						"tools": {
							"resolve-library-id": true,
							"query-docs": true,
						},
					},
				},
			},
		},
		"default_profile": "ask",
		"default_model": {
			"effort": "high",
			"enable_thinking": true,
			"provider": "copilot_chat",
			"model": "gemini-3.1-pro-preview",
		},
		"inline_assistant_model": {
			"provider": "copilot_chat",
			"model": "gemini-3.1-pro-preview",
		},
	},
	"agent_servers": {
		"opencode": {
			"type": "registry",
		},
	},
	"lsp": {
		"rust-analyzer": {
			"initialization_options": {
				"check": {
					"command": "clippy",
				},
			},
		},
	},
}
