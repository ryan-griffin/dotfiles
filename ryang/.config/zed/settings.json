// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"vim_mode": false,
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"features": {
		"edit_prediction_provider": "zed"
	},
	"assistant": {
		"default_model": {
			"provider": "copilot_chat",
			"model": "claude-3-7-sonnet"
		},
		"version": "2"
	},
	"ui_font_size": 16,
	"buffer_font_size": 14,
	"ui_font_family": "Adwaita Sans",
	"buffer_font_family": "JetBrainsMono Nerd Font",
	"theme": {
		"mode": "system",
		"light": "Xcode Default Light",
		"dark": "Xcode Default Darker"
	},
	"experimental.theme_overrides": {
		"syntax": {
			"comment": {
				"font_style": "italic"
			},
			"operator": {
				"color": "#63b7fffb"
			}
		}
	},
	"hard_tabs": true,
	"tab_size": 4,
	"soft_wrap": "editor_width",
	"tabs": {
		"file_icons": true
	},
	"restore_on_startup": "none",
	"format_on_save": "on",
	"languages": {
		"C": {
			"formatter": {
				"external": {
					"command": "clang-format",
					"arguments": [
						"--style={ BasedOnStyle: LLVM, UseTab: AlignWithSpaces, TabWidth: 4, IndentWidth: 4, AllowShortFunctionsOnASingleLine: Empty, IndentCaseLabels: true }"
					]
				}
			}
		}
	}
}
